# ============================================================
# VAROSA — Comercializadora VARO S.A.
# Configuración Apache para hosting en Bluehost (SPA React + Vite).
# Este archivo se copia tal cual a la raíz del sitio en el build.
# ============================================================

# ------------------------------------------------------------
# 0) Limpieza de URLs viejas de WordPress + 1) Reescritura SPA
#    Las redirecciones 301/410 VAN ANTES del catch-all SPA; si no,
#    index.html se sirve primero y la redirección nunca se ejecuta.
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ------------------------------------------------------------
  # 0) Limpieza de URLs viejas de WordPress
  #    VAN ANTES del catch-all SPA. Si no, index.html se sirve
  #    primero y la redirección nunca se ejecuta.
  # ------------------------------------------------------------

  # A) Rutas/archivos internos de WordPress que ya no existen -> 410 (eliminada)
  RewriteRule ^wp-admin(/|$)     - [G,L]
  RewriteRule ^wp-login\.php$    - [G,L]
  RewriteRule ^wp-json(/|$)      - [G,L]
  RewriteRule ^wp-content(/|$)   - [G,L]
  RewriteRule ^wp-includes(/|$)  - [G,L]
  RewriteRule ^xmlrpc\.php$      - [G,L]
  RewriteRule ^wp-.*\.php$       - [G,L]

  # B) Feeds de WordPress -> 410 (eliminada)
  RewriteRule ^feed(/|$)          - [G,L]
  RewriteRule ^comments/feed(/|$) - [G,L]

  # C) Categoría "Destacado" -> Productos (301). Destino confirmado.
  RewriteRule ^category/destacado/?$ /productos [R=301,L]

  # D) Otras categorías/etiquetas/autores viejos -> Home (301)
  RewriteRule ^category(/|$) / [R=301,L]
  RewriteRule ^tag(/|$)      / [R=301,L]
  RewriteRule ^author(/|$)   / [R=301,L]

  # ------------------------------------------------------------
  # 0.5) Prerender: servir /ruta/index.html ante /ruta SIN barra final
  #    Las 9 rutas prerenderizadas son directorios reales
  #    (dist/productos/index.html -> public_html/productos/index.html). Por
  #    defecto mod_dir haría un 301 de /productos -> /productos/ (barra final).
  #    Desactivamos ese redirect y servimos el index.html internamente, para que
  #    la URL SIN barra responda 200 directo, alineada con canonical / og:url /
  #    sitemap / enlaces internos (que usan la forma sin barra).
  #    Solo aplica cuando existe <ruta>/index.html; las rutas NO prerenderizadas
  #    (p. ej. /gracias) caen al catch-all SPA de abajo sin cambios.
  # ------------------------------------------------------------
  <IfModule mod_dir.c>
    DirectorySlash Off
  </IfModule>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # ------------------------------------------------------------
  # 1) Reescritura SPA (idéntica a la original)
  #    Cualquier ruta que NO sea un archivo o carpeta real se sirve
  #    con index.html, para que React Router resuelva la ruta del
  #    lado del cliente (necesario tras migrar a BrowserRouter).
  # ------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------
# 2) Cabeceras de seguridad
# ------------------------------------------------------------
<IfModule mod_headers.c>
  # Evita que el navegador "adivine" (sniff) el MIME type de una respuesta.
  Header always set X-Content-Type-Options "nosniff"

  # Limita cuánta información de referer se envía a otros orígenes.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Impide que el sitio sea embebido en frames de otros orígenes (anti-clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"

  # Restringe APIs sensibles del navegador:
  #  - camera y microphone: deshabilitadas por completo (el sitio no las usa).
  #  - geolocation: permitida SOLO para el propio sitio y el formulario de Zoho
  #    (el iframe de forms.zohopublic.com en Contacto tiene geolocalización
  #    habilitada; bloquearla del todo rompería esa función del formulario).
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self \"https://forms.zohopublic.com\")"

  # HSTS: fuerza HTTPS durante 1 año. Se deja SIN includeSubDomains/preload
  #  por ahora, para no forzar HTTPS en subdominios durante la fase de pruebas;
  #  al pasar a producción raíz se puede endurecer.
  Header always set Strict-Transport-Security "max-age=31536000"

  # ----------------------------------------------------------
  # 3) Content-Security-Policy — modo REPORT-ONLY
  #    NO bloquea nada: solo reporta violaciones (consola / endpoint)
  #    para afinar la política antes de activarla en modo enforce.
  #    Directivas (cada origen externo está justificado):
  #      default-src 'self'          -> por defecto, solo el propio origen.
  #      script-src                  -> scripts propios + 'unsafe-inline' (snippet
  #                                     inline de GTM) + GTM + Google Analytics.
  #      style-src                   -> estilos propios + 'unsafe-inline'
  #                                     (estilos inline de Tailwind/Radix/React).
  #      img-src                     -> imágenes propias + data: (favicons/inline)
  #                                     + tienda.varosacr.com (fotos de producto)
  #                                     + tiles/recursos de Google Maps
  #                                     + pixeles de GTM/Analytics.
  #      font-src 'self'             -> fuentes self-hosted (Bw Mitga, Montserrat).
  #      connect-src                 -> beacons de GA4 (google-analytics /
  #                                     region1.google-analytics) y GTM.
  #      frame-src                   -> iframes embebidos: formulario Zoho,
  #                                     Google Maps y el noscript de GTM.
  #      object-src 'none'           -> sin plugins/objetos embebidos.
  #      base-uri 'self'             -> no permite reescribir <base>.
  #      form-action 'self'          -> envíos de formularios solo al propio origen
  #                                     (el form de cotización vive dentro del iframe Zoho).
  #      frame-ancestors 'self'      -> equivalente a X-Frame-Options (anti-clickjacking).
  # ----------------------------------------------------------
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tienda.varosacr.com https://maps.gstatic.com https://www.google.com https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com; font-src 'self'; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com; frame-src https://forms.zohopublic.com https://www.google.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>
